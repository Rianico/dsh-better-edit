{
  "$schema": "https://biomejs.dev/schemas/2.1.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
  "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "useTemplate": "off", "useNodejsImportProtocol": "off" },
      "suspicious": { "noExplicitAny": "off", "noTemplateCurlyInString": "off", "noImplicitAnyLet": "off", "noAssignInExpressions": "off" },
      "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off", "noUnusedFunctionParameters": "off" },
      "complexity": { "useOptionalChain": "off", "useRegexLiterals": "off", "noUselessEscapeInRegex": "off", "noUselessContinue": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "assist": { "enabled": false },
  "overrides": [
    { "includes": ["**/*.json", "**/*.cjs"], "linter": { "enabled": false } },
    { "includes": ["test/**"], "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } } }
  ]
}
