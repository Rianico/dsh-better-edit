{
  "name": "dsh-better-edit",
  "version": "0.7.1",
  "description": "Hash-anchored read/edit/undo_last_edit tools for DeepSeek Harness (dsh). Every line gets a unique 3-char hash (A-Za-z0-9) that stays stable across edits; stale or ambiguous anchors are rejected, never fuzzy-matched. Undo persists across restarts.",
  "keywords": [
    "anchors",
    "batch-edit",
    "coding-agent",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "edit",
    "file-editing",
    "hash",
    "hash-anchored",
    "hashline",
    "oh-my-pi",
    "read",
    "stable",
    "undo"
  ],
  "homepage": "https://github.com/Rianico/dsh-better-edit",
  "bugs": {
    "url": "https://github.com/Rianico/dsh-better-edit/issues"
  },
  "license": "MIT",
  "author": "dsh-better-edit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rianico/dsh-better-edit.git"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "assets/",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json && husky",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && node scripts/assert-tagged.mjs",
    "benchmark": "node benchmark/run.mjs",
    "postpublish": "node scripts/tag-current.mjs",
    "release": "node scripts/release.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:check": "oxfmt --check .",
    "test:coverage": "vitest run --coverage",
    "format:fix": "oxfmt ."
  },
  "dependencies": {
    "diff": "^8.0.2",
    "file-type": "^21.3.0",
    "iconv-lite": "^0.6.3",
    "xxhash-wasm": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.7",
    "js-tiktoken": "1.0.21",
    "oxfmt": ">=0.15",
    "oxlint": ">=1",
    "semantic-release": "^25.0.9",
    "tsx": ">=4",
    "typescript": ">=7",
    "vite": ">=8",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "chardet": "2.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.0.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
